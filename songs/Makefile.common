QT_QPA_PLATFORM=offscreen
export QT_QPA_PLATFORM

clean:
	rm gen/*

gen/${PREFIX}sheet-music.pdf: sheet-music.ly
	lilypond -o gen/${PREFIX}sheet-music sheet-music.ly

gen/${PREFIX}sheet-music.midi: gen/${PREFIX}sheet-music.pdf
	test -e gen/${PREFIX}sheet-music.midi

gen/${PREFIX}sheet-music-legal.pdf: sheet-music.ly
	lilypond '-dpaper-size="legal"' -o gen/${PREFIX}sheet-music-legal sheet-music.ly
	rm gen/${PREFIX}sheet-music-legal.midi

gen/${PREFIX}sheet_music.pdf: sheet-music.mscx
	musescore -o gen/${PREFIX}sheet_music.pdf sheet-music.mscx

gen/${PREFIX}from-midi.wav: gen/${PREFIX}sheet-music.midi
	timidity gen/${PREFIX}sheet-music.midi -Ow -o gen/${PREFIX}from-midi.wav

gen/${PREFIX}from-midi.mp3: gen/${PREFIX}from-midi.wav
	lame  gen/${PREFIX}from-midi.wav gen/${PREFIX}from-midi.mp3

gen/${PREFIX}from_midi.mp3: sheet-music.mscx
	musescore -o gen/${PREFIX}from_midi.mp3 sheet-music.mscx

gen/${PREFIX}chord-chart.html: chart.csv ../../scripts/csv-to-html.py
	../../scripts/csv-to-html.py chart.csv gen/${PREFIX}chord-chart.html

gen/${PREFIX}%--chord-chart.html: %--chart.csv ../../scripts/csv-to-html.py
	../../scripts/csv-to-html.py $*--chart.csv gen/${PREFIX}$*--chord-chart.html

gen/${PREFIX}%.pdf: $(wildcard %.cho) $(wildcard gen/${PREFIX}%.cho)
	( cat $*.cho gen/${PREFIX}$*.cho 2>/dev/null ) | chordpro --output gen/${PREFIX}$*.pdf -

gen/${PREFIX}%-2col.pdf: $(wildcard %.cho) $(wildcard gen/${PREFIX}%.cho)
	( echo '{columns:2}' ; cat $*.cho gen/${PREFIX}$*.cho 2>/dev/null ) | chordpro --output gen/${PREFIX}$*-2col.pdf -

gen/${PREFIX}%-legal.pdf: $(wildcard %.cho) $(wildcard gen/${PREFIX}%.cho) ../legal.json
	( cat $*.cho gen/${PREFIX}$*.cho 2>/dev/null ) | chordpro --config=$(shell pwd)/../legal.json --output gen/${PREFIX}$*-legal.pdf -

gen/${PREFIX}%-2col-legal.pdf: $(wildcard %.cho) $(wildcard gen/${PREFIX}%.cho) ../legal.json
	( echo '{columns:2}'; cat $*.cho gen/${PREFIX}$*.cho 2>/dev/null ) | chordpro --config=$(shell pwd)/../legal.json --output gen/${PREFIX}$*-2col-legal.pdf -

gen/${PREFIX}%.cho: %.ugc ../../scripts/parse_ugc.py
	../../scripts/parse_ugc.py $*.ugc --cp > gen/${PREFIX}$*.cho

ifdef ALTERNATE_VERSIONS
      FILES_TO_LIST_REALLY=${FILES_TO_LIST} $(foreach v, ${ALTERNATE_VERSIONS}, $(foreach f, ${FILES_TO_LIST}, ${v}--${f}))
      $(info ${FILES_TO_LIST_REALLY})
else
      FILES_TO_LIST_REALLY=${FILES_TO_LIST}
endif

FILES=$(foreach f, ${FILES_TO_LIST_REALLY}, gen/${PREFIX}${f})

gen/thumb.png: $(wildcard gen/${PREFIX}*.pdf) $(wildcard gen/${PREFIX}*.html) ../../scripts/create-thumb.sh ${FILES}
	../../scripts/create-thumb.sh "${PREFIX}"

gen/index.html: README.md ${FILES} gen/thumb.png ../../scripts/create-index.py
	../../scripts/create-index.py "${PREFIX}" > gen/index.html

all: gen/index.html
